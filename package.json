{
  "name": "@jenishk29/ai-context-manager",
  "version": "1.0.2",
  "description": "Complete AI context management solution — event tracking, snapshot generation, and seamless context handoff between AI tools. Works as both CLI and library.",
  "author": "Jenish Kheni",
  "license": "MIT",
  "homepage": "https://github.com/jenishk29/ai-context-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jenishk29/ai-context-manager.git"
  },
  "bugs": {
    "url": "https://github.com/jenishk29/ai-context-manager/issues"
  },
  "keywords": [
    "ai",
    "context",
    "context-management",
    "events",
    "handoff",
    "snapshot",
    "claude",
    "gpt",
    "gemini",
    "copilot",
    "llm",
    "workflow",
    "cli",
    "developer-tools",
    "productivity",
    "token-optimization",
    "model-switching"
  ],
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/cjs/src/index.d.ts",
  "bin": {
    "acm": "./dist/cjs/bin/cli.js",
    "ai-context-manager": "./dist/cjs/bin/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "schemas/",
    "templates/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true})\"",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && echo {\\\"type\\\":\\\"module\\\"} > dist/esm/package.json",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run fix-bin-shebang",
    "fix-bin-shebang": "node -e \"const fs=require('fs'); const p='dist/cjs/bin/cli.js'; let c=fs.readFileSync(p,'utf8'); if(!c.startsWith('#!/usr/bin/env node')){fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c)}\"",
    "test": "npm run build && node --test tests/**/*.test.js",
    "test:unit": "npm run build && node --test tests/unit/**/*.test.js",
    "test:integration": "npm run build && node --test tests/integration/**/*.test.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^4.1.2",
    "clipboardy": "^2.3.0",
    "ejs": "^3.1.10",
    "fast-glob": "^3.3.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^18.19.0",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
